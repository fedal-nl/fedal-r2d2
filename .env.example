# Copy this file to .env for local development:
#   cp .env.example .env
#
# Never commit real secrets. Generate strong tokens with:
#   openssl rand -hex 32

# -----------------------------------------------------------------------------
# Database and local Docker Compose
# -----------------------------------------------------------------------------
# Used by commands executed on the host, including Alembic migrations.
DATABASE_URL=postgresql://fedal:change-this-local-password@localhost:5433/fedal_r2d2

# Used by the PostgreSQL container. Keep the credentials synchronized with
# DATABASE_URL. The API container receives postgres:5432 automatically.
POSTGRES_USER=fedal
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=fedal_r2d2
POSTGRES_PORT=5433

# Host port mapped to the API container's port 8000.
API_HOST_PORT=8002

# -----------------------------------------------------------------------------
# User authentication (required)
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32
JWT_ISSUER=fedal-r2d2
JWT_AUDIENCE=fedal-r2d2-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_MINUTES=15

# -----------------------------------------------------------------------------
# Shared API authentication
# -----------------------------------------------------------------------------
# Protects POST /api/v1/email/send-email.
API_TOKEN=replace-with-openssl-rand-hex-32

# -----------------------------------------------------------------------------
# General email profile (optional)
# -----------------------------------------------------------------------------
# Used only when a request contains "application": "general".
RESEND_API_KEY=re_replace_with_general_key
EMAIL_FROM=R2D2 <noreply@example.com>
# Fixed recipient used by POST /api/v1/email/send-email.
EMAIL_TO=owner@example.com

# -----------------------------------------------------------------------------
# Application email profiles (optional; add one section per application)
# -----------------------------------------------------------------------------
# The application identifier determines the uppercase environment suffix.
# Example: "application": "aicentralhub" selects the variables below.
# EMAIL_TO_AICENTRALHUB is not required for /send-user-email because its
# authenticated backend supplies the recipient in the request's `to` field.
AICENTRALHUB_TOKEN=replace-with-openssl-rand-hex-32
RESEND_API_KEY_AICENTRALHUB=re_replace_with_aicentralhub_key
EMAIL_FROM_AICENTRALHUB=AI Central Hub <noreply@example.com>
# EMAIL_TO_AICENTRALHUB=owner@example.com

# Fixed-recipient example for POST /api/v1/email/send-email.
RESEND_API_KEY_ZAANSRECHT=re_replace_with_zaansrecht_key
EMAIL_FROM_ZAANSRECHT=Zaansrecht <noreply@example.com>
EMAIL_TO_ZAANSRECHT=owner@example.com

# Password-reset emails use the Spanglish profile and a dynamic recipient.
RESEND_API_KEY_SPANGLISH=re_replace_with_spanglish_key
EMAIL_FROM_SPANGLISH=Spanglish <noreply@example.com>
# EMAIL_TO_SPANGLISH=owner@example.com

# -----------------------------------------------------------------------------
# Form integrations (optional)
# -----------------------------------------------------------------------------
RECAPTCHA_SECRET_KEY=replace-with-recaptcha-secret
